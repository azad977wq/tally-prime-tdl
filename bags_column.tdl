;===============================================================================
; RiceMill_ManualBags_For_TallyPrime.tdl
; উদ্দেশ্য:
;   TallyPrime-এ Alternate Unit-এর fixed conversion ছাড়া "Bags" (ব্যাগ সংখ্যা)
;   ম্যানুয়ালি এন্ট্রি করার ব্যবস্থা করা।
;
; কীভাবে কাজ করবে:
;   - Stock Item-এর Base Unit আপনি "মন"/Kg (যেটা আপনার স্টক মেইনটেইন করবেন) রাখবেন
;   - Purchase/Sales-এ Quantity ফিল্ডে মোট মন (বা Kg) দিবেন
;   - পাশাপাশি "Bags" ফিল্ডে ব্যাগ সংখ্যা (১০০, ১২০ ইত্যাদি) আলাদা করে লিখবেন
;
; নোট:
;   Tally-এর native Alternate Unit সবসময় fixed conversion চায়।
;   এই TDL-এ "Bags" আলাদা UDF হিসেবে রাখা হচ্ছে—তাই conversion fixed হবে না।
;===============================================================================

[System: UDF]
    RM_Bags    : Number : 10000

;------------------------------
; Voucher inventory line এ Bags ইনপুট ফিল্ড যোগ
;------------------------------

[Field: RM Bags] ; (পুরোনো নাম—compatibility)
    Use         : Number Field
    Storage     : RM_Bags
    Set Always  : Yes
    Width       : 8
    Align       : Right

[Field: RMBagsValue] ; (বর্তমান/ব্যবহৃত ফিল্ড)
    Use         : Number Field
    Storage     : RM_Bags
    Set Always  : Yes
    Width       : 8
    Align       : Right

[Field: RM Bags Unit]
    Use       : Name Field
    Set As    : "ব্যাগ"
    Width     : 5
    Align     : Left
    Skip      : Yes

;------------------------------------------------------------
; TallyPrime Item Invoice স্ক্রিনে কলাম দেখানোর জন্য
; (Purchase/Sales → Item Invoice)
;------------------------------------------------------------

[Field: RM Bags Title]
    Use       : Name Field
    Set As    : "Bags"
    Width     : 8
    Align     : Right
    Skip      : Yes

[Field: RM Bags Unit Title]
    Use       : Name Field
    Set As    : ""
    Width     : 5
    Skip      : Yes

; Heading line-এ "Bags" শিরোনাম
[#Line: EI ColumnOne]
    Add : Right Field : Before : VCH QtyTitle : RM Bags Title
    Add : Right Field : After  : RM Bags Title : RM Bags Unit Title
    ; Stock Journal (এখানে Quantity title হিসেবে VCH BilledQtyTitle থাকে)
    Add : Fields      : Before : VCH BilledQtyTitle : RM Bags Title
    Add : Fields      : After  : RM Bags Title : RM Bags Unit Title

; Entry line-এ Bags ইনপুট (Qty কলামের পাশেই)
[#Line: EI InvInfo]
    Add : Right Field : Before : VCH ActualQty : RMBagsValue
    Add : Right Field : After  : RMBagsValue : RM Bags Unit
    ; Stock Journal Source (Consumption) Qty field tooltip: VCH BilledQty
    Add : Fields      : Before : VCH BilledQty : RMBagsValue
    Add : Fields      : After  : RMBagsValue : RM Bags Unit
    ; Stock Journal Destination (Production) Qty field tooltip: VCHSTKJrnl BilledQty
    Add : Fields      : Before : VCHSTKJrnl BilledQty : RMBagsValue
    Add : Fields      : After  : RMBagsValue : RM Bags Unit

; Purchase/Sales voucher-এ Total Bags দেখানোর জন্য
[#Part: EI InvInfo]
    Total : RMBagsValue

[Field: RMBagsTotal]
    Use        : Number Field
    Set As     : $$Total:RMBagsValue
    Set Always : Yes
    Width      : 8
    Align      : Right
    Skip       : Yes

[Field: RMBagsTotalUnit]
    Use        : Name Field
    Set As     : "ব্যাগ"
    Width     : 5
    Align      : Left
    Skip       : Yes

[#Field: EI QtyTotal]
    Add : Field : Before : EI BilledQtyTotal : RMBagsTotal
    Add : Field : After  : RMBagsTotal : RMBagsTotalUnit

;------------------------------------------------------------
; Stock Journal (Alt+F7) – Default TDL References থেকে পাওয়া Line নাম
;   Source (Consumption) side → Line: SJDetailsB (Field: VCH BilledQty)
;   Destination (Production) side → Line: GTRNDetails (Field: VCHSTKJrnl BilledQty)
;------------------------------------------------------------

[#Line: SJDetailsB]
    ; কিছু স্ক্রিনে Fields/Left Fields/Right Fields আলাদা হতে পারে—তাই তিনভাবেই add করা হলো
    Add : Fields       : Before : VCH BilledQty : RMBagsValue
    Add : Left Fields  : Before : VCH BilledQty : RMBagsValue
    Add : Right Fields : Before : VCH BilledQty : RMBagsValue

    ; Destination field যদি এই Line-এ থাকে, সেক্ষেত্রে Bags এখানেও বসবে
    Add : Fields       : Before : VCHSTKJrnl BilledQty : RMBagsValue
    Add : Left Fields  : Before : VCHSTKJrnl BilledQty : RMBagsValue
    Add : Right Fields : Before : VCHSTKJrnl BilledQty : RMBagsValue

    Add : Fields       : After  : RMBagsValue : RM Bags Unit
    Add : Left Fields  : After  : RMBagsValue : RM Bags Unit
    Add : Right Fields : After  : RMBagsValue : RM Bags Unit

[#Line: GTRNDetails]
    Add : Fields       : Before : VCHSTKJrnl BilledQty : RMBagsValue
    Add : Left Fields  : Before : VCHSTKJrnl BilledQty : RMBagsValue
    Add : Right Fields : Before : VCHSTKJrnl BilledQty : RMBagsValue

    Add : Fields       : After  : RMBagsValue : RM Bags Unit
    Add : Left Fields  : After  : RMBagsValue : RM Bags Unit
    Add : Right Fields : After  : RMBagsValue : RM Bags Unit

; Destination (Production) side-এর জন্য আপনার Reference list অনুযায়ী Line: SJDetailsD
[#Line: SJDetailsD]
    Add : Fields       : Before : VCHSTKJrnl BilledQty : RMBagsValue
    Add : Left Fields  : Before : VCHSTKJrnl BilledQty : RMBagsValue
    Add : Right Fields : Before : VCHSTKJrnl BilledQty : RMBagsValue

    Add : Fields       : After  : RMBagsValue : RM Bags Unit
    Add : Left Fields  : After  : RMBagsValue : RM Bags Unit
    Add : Right Fields : After  : RMBagsValue : RM Bags Unit

;------------------------------------------------------------
; Stock Journal-এ Total Bags দেখানোর জন্য (Source + Destination দুই পাশেই)
;------------------------------------------------------------

[Field: RMBagsSJTotalLabel]
    Use    : Name Field
    Set As : "মোট ব্যাগ:"
    Width  : 10
    Align  : Right

[Field: RMBagsSJTotalValue]
    Use        : Number Field
    Set As     : $$Total:RMBagsValue
    Set Always : Yes
    Width      : 8
    Align      : Right
    Skip       : Yes

[Field: RMBagsSJTotalUnit]
    Use    : Name Field
    Set As : "ব্যাগ"
    Width  : 5
    Align  : Left
    Skip   : Yes

[Line: RMBagsSJTotalLine]
    Fields : RMBagsSJTotalLabel, RMBagsSJTotalValue, RMBagsSJTotalUnit

[#Part: SJOut]
    Total : RMBagsValue
    Add   : Bottom Lines : RMBagsSJTotalLine

[#Part: SJIn]
    Total : RMBagsValue
    Add   : Bottom Lines : RMBagsSJTotalLine

;------------------------------
; নোট:
;   UDF হিসেবে Bags সংরক্ষণ হবে। চাইলে পরে কাস্টম রিপোর্ট/প্রিন্ট ফরম্যাটেও
;   দেখানোর ব্যবস্থা করে দেওয়া যাবে।
;------------------------------
;===============================================================================
; END
;===============================================================================
